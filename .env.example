# Supabase 프로젝트 설정 (비워 두면 비로그인 미리보기·PNG만 동작하고 저장/공유 API는 503을 반환)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용: 공유 스냅샷 읽기(ShareService 읽기 모듈)에서만 사용. NEXT_PUBLIC 접두사를 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=
# 동일 출처 검사 기준 (예: http://localhost:3000)
APP_ORIGIN=http://localhost:3000

# CLIP 서버 추론: 배포 서버에서는 Python 실행 파일과 HF_HOME 캐시 경로 지정.
# 로컬 개발은 eval/recognition/model-env 및 model-cache를 자동 사용. 가중치는 사전 설치하며 요청 중 다운로드하지 않음.
CLIP_PYTHON=
CLIP_MODEL_CACHE=

ROAD_DATA_DIR=

# 지도 장소 검색 (카카오 로컬 API REST 키, 서버 전용). 비워 두면 검색창이 "설정되지 않았어요"를 보여 준다.
KAKAO_REST_API_KEY=

# 도로 선 그림 기반 이름·참고 그림 생성 (OpenAI API, 서버 전용).
# 실제 키는 Git에서 제외된 .env.local에만 입력. NEXT_PUBLIC 접두사를 붙이지 말 것.
# 키가 비어 있으면 외부 생성은 실행하지 않고 기존 CLIP 해석을 사용.
# GPS·주소 대신 정규화한 선 그림만 전송. 검색당 최대 3회, 자동 재시도 없음.
OPENAI_API_KEY=
ROAD_REFERENCE_MODEL=gpt-5.4-mini
# 프로세스 내 이동 1시간 동안 실제 호출 상한(1~120, 기본60). 재시작/여러 서버에 걸친 과금 상한은 아님.
ROAD_REFERENCE_MAX_CALLS_PER_HOUR=60
